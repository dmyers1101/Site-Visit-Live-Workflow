# Copy to a local .env and fill in the real values.

# GitHub
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
SITE_VISIT_ENVIRONMENT=local
SITE_VISIT_RUNTIME_SERVICE_ACCOUNT=site-visit-workflow@shir-sitevisit.iam.gserviceaccount.com

# Workflow settings
DRIVE_SHARED_FOLDER_ID=
GCS_STAGING_BUCKET=
GCS_STAGING_PREFIX=site-visit-staging
CATALOG_SHEET_ID=
LOCAL_STAGING_DIR=./data/staging
LOCAL_OUTPUT_DIR=./data/output
LOG_LEVEL=INFO

# --- Live deployed workflow (Phase 2, added 2026-09-17) ---
# Values the Cloud Run Job runs with. See docs/SETUP.md.
# Chirp 3 is served from the `us`/`eu` MULTI-REGIONS, not from us-central1.
SPEECH_LOCATION=us
# The Speech-to-Text v2 model string. The legacy alias `chirp` is REJECTED with
# an explicit error rather than silently remapped; any TRANSCRIPTION_MODEL entry
# elsewhere is a non-authoritative alias that no code reads.
SPEECH_MODEL=chirp_3
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
CATALOG_TAB_NAME=Catalog
RUN_ID=

# NOTE: a previous local copy of this template carried
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
# Do not reintroduce it. The deployed workflow uses ambient ADC from the
# Cloud Run metadata server; a service-account key file is prohibited.

# Do not add service-account JSON key paths, access tokens, or media data here.

# How to update this later: add only non-secret configuration read by Settings,
# document it in docs/SETUP.md, and add validation/tests before use.

# --- Gates 6 and 7 (added 2026-09-18) ---
# CATALOG_SHEET_ID above is now OPTIONAL for `process-folder`: leave it empty
# and the run creates its own spreadsheet in DRIVE_OUTPUT_PARENT_ID, reporting
# the new ID in the run summary. `publish-catalog` still requires it.
# Same for the report Doc.
REPORT_DOC_ID=
# Where self-provisioned output files are created. Defaults to
# DRIVE_SHARED_FOLDER_ID when empty.
DRIVE_OUTPUT_PARENT_ID=
# Gate 6 approval, half of two. The rename ALSO requires the --rename-approved
# CLI flag; either one alone authorizes nothing. Accepts 1/true/yes/on.
RENAME_APPROVED=
