# Copy to a local .env and fill in the real values.

# GitHub
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# Workflow settings
UPLOAD_FOLDER=./data/sample
OUTPUT_FOLDER=./data/output
RUN_MODE=dev
LOG_LEVEL=INFO

# Future pipeline settings
TRANSCRIPTION_MODEL=chirp
CATALOG_SHEET_ID=
REPORT_OUTPUT_FOLDER=./data/reports
